params {
    
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                        Input files
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// 1) input fastq
FASTQ_direct_path='/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/test/*_{R1,R2,1,2,R1_001,R2_001}*.{fastq,fq}.gz'
FASTQ_list_path="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/test/List_fastq.txt"

metadata="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/test/metadata.txt"

// 2) Or if you want to run from any other steps, with files not generated by the pipeline, provide a list of files from the step before with absolute path 
// Note: In this case, only the samples provided in the external files list will be performed, not the one provided from sequencing data to the pipeline

// Format: either one absolute path per line, or "SAMPLE<TAB>/abs/path/to/SAMPLE_merged.fastq.gz"
OVERRIDE_LIST_FASTP="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/test/list_override_fastq2.txt" // Give absolute path - In the case you are not using fastp to preprocess the reads
//OVERRIDE_LIST_SGA="" //"/cfs/klemming/projects/supr/sllstore2017093/sediment/nathan/pipeline_metage_out/01_fastp/List_SGA.txt" // Give absolute path
//OVERRIDE_LIST_PRINSEQ="" //"/cfs/klemming/projects/supr/sllstore2017093/sediment/nathan/pipeline_metage_out/01_fastp/List_Prinseq.txt"

OVERRIDE_LIST_KRAKEN="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/test/list_override_fastq2.txt"
OVERRIDE_LIST_BAM="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/out/04_mapping/list_bam.txt" // given list of bam files 
//OVERRIDE_LIST_FILTER="" //"/cfs/klemming/projects/supr/sllstore2017093/sediment/nathan/pipeline_metage_out/04_mapping/List_filter.txt" // Give absolute path
//OVERRIDE_LIST_METRICS="" //"/absolute/path/to/List_filter.txt"

// If you already have SGA output (name: <sample>_merged.dust.rmdup.fastq.gz)
//SGA_OUT_DIR=""
// If you already have Kraken2 unclassified (name: <sample>_GTDB_unclas.fastq.gz)
//KRAKEN_UNCLAS_DIR=""
// If you already have mapping BAMs (name: <sample>.b2.k1000.all.sorted.bam)
//MAPPING_BAM_DIR=""

///// OUTPUT Directories///
OUTPUT_Dir="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/metaJAM/nf_metaJAM/out"

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                        Path to scripts and databases
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


BOWTIE2_MAPPING_DBs="./test/list_mapping_indexs_test" // each line as the bowtie2 mapping index header

// Kraken2 GTDB 
KRAKEN2_FILTER_DATABASE="/cfs/klemming/pdc/software/dardel/sw-uppmax/data/Kraken2_data/prebuilt/k2_viral_20251015"

// NCBI taxonomy files
NAMES="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/eMeta/taxonomy/names.dmp"
NODES="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/eMeta/taxonomy/nodes.dmp"
ACC2TAXID="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/chap3_popgen/251028/list/mito_plastid.acc2taxid.special.gz"

// MMSeqs2 database
//MMSEQS2_DB="/sw/data/MMseqs2_data/latest/rackham/NT"
MMSEQS2_DB="/sw/data/MMseqs2_data/latest/rackham/CDD"
MMSEQS2_TAXADB_SQLITE="/cfs/klemming/projects/supr/sediment_paleogenomics/tools/metaJAM/taxadb_nucl.sqlite"

//////// Path to metadata (???)
METADATA_PATH="/cfs/klemming/projects/supr/sllstore2017093/sediment/nathan/metadata.txt"


//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                              Tools activation                                   //
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

//////// enable or disable
ENABLE_PREPROCESS="disable"     // If disabled, neither fastp or SGA will run
    ENABLE_FASTP="enable"
    ENABLE_SGA="enable"
    ENABLE_PRINSEQ="enable"        // enable to use PRINSEQ instead of SGA  
    // ENABLE_LOW_COMPLEXITY_FILTER="SGA" // or PRINSEQ       
    ENABLE_LOW_COMPLEXITY_FILTER="PRINSEQ" // SGA or PRINSEQ results will be used

//ENABLE_KRAKEN_GTDB="enable"
ENABLE_KRAKEN_GTDB="disable"
ENABLE_MAPPING="disable"
ENABLE_MASK_REGIONS="enable"
// ENABLE_FILTERING="enable"      // If disabled, neither filterBAM or ngsLCA or bamdam will run
// ENABLE_FILTERBAM="disable" // [not available: wait for update for using it for eukaryotes]
ENABLE_NGSLCA="enable"
ENABLE_BAMDAM="disable"
ENABLE_MMSEQS2="disable" // enable this requires ENABLE_BAMDAM
ENABLE_METRICS_PLOT="disable" // enable this requires ENABLE_BAMDAM
// ENABLE_METRICS="enable"
// ENABLE_PLOTS="disable"

 
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                       Tools' parameters to precise
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// fastp
FASTP_OVERLAP_LEN_REQUIRE=20   // --overlap_len_require
FASTP_MIN_LENGTH=30            // -l
// SGA
SGA_DUST_THRESHOLD=4           // --dust-threshold
SGA_CLEAN_INDEX=1              // 0 (disable) or 1 (enable). If enable it will remove all index files after sga step is done, to get extra space
// PRINSEQ params (defaults mirror your snippet)
PRINSEQ_COMPLEXITY_METHOD="dust"
PRINSEQ_COMPLEXITY_THRESHOLD=4
PRINSEQ_MIN_LEN=35
PRINSEQ_DEREP="14"                      // exact fwd+rev duplicates

BOWTIE2_N_ALLOW_MULTIMAPPER=1000

// Mapping run name (used to bundle outputs)
//MAP_RUN="default_run"

// Mask regions
REGIONS_TO_MASK="/cfs/klemming/projects/snic/snic2022-6-144/CHENYU/MCWorkflow/output/mito_plastid.bed" // a bed file with all regions to be masked

// bamdam parameters (used only if ENABLE_BAMDAM=1)
BAMDAM_STRANDED="ds"          // "ds" or "ss"
BAMDAM_MINREADS=5             // for bamdam krona --minreads
BAMDAM_MAXDAMAGE=0.5          // for bamdam krona --maxdamage
BAMDAM_TOP_GENUS=10                  // Top X genus to plot for damage
BAMDAM_TAXA_PER_PLOT=50       // Number of taxa passing the filters to plot per graph

// MMseqs2 search settings (optional, but good to centralize)
MMSEQS2_THREADS=60
MMSEQS2_MAX_SEQS=300
MMSEQS2_MIN_LENGTH=30
MMSEQS2_MIN_SEQID=0.85
MMSEQS2_MIN_BITS=50
MMSEQS2_MIN_QUERY_COV=0.95
MMSEQS2_MAX_EVALUE="1e-5"
MMSEQS2_S=7.5
MMSEQS2_SPACED_KMER_MODE=1
MMSEQS2_SPLIT_MEM_LIMIT="220G"
// MMSeqs2 evaluation parameters
MMSEQS2_TOP_GENERA=10
//GENERA_FILE: If a list file is give, the genera selected for investigation through MMSeqs2 will be provided from the list file and the TOP_GENERA argument will be skipped. The lsit should be in shape of 1 genera name per line.
// if no GENERA_FILE, replace it with ""
MMSEQS2_GENERA_FILE="assets/NO_FILE" // path to a file containing genera of interst at each line (?); otherwise use 'assets/NO_FILE' 
MMSEQS2_MIN_DMG=3.5
MMSEQS2_MAX_READS=100
MMSEQS2_MIN_READS=30
MMSEQS2_SEED="42"               // Leave empty to have different reads each run, othewise set an integer (e.g. 42)
MMSEQS2_AMBIG_FRAC=0.1         // Percent of e-value difference for the second best hit for a different genera than the mmseqs2 best hit 
MMSEQS2_DATABASE_NAME="nt_query"

// Plot parameters
PLOTS_BAMDAM_MIN_READS=50       // Minimum reads per sample to include in bamdam plots
PLOTS_BAMDAM_PLOT_MODE="both"   // heatmap, bubble, both
PLOTS_DAMAGE_THRESHOLD=3.5      // Minimum percentage of damage for plotting
PLOTS_PLOT_LOW_DAMAGE_TAXA=0    // 1 = keep low-damage taxa (default); 0 = drop taxa whose max damage across samples is < PLOTS_DAMAGE_THRESHOLD
PLOTS_EXCLUDE_TAXA="Homo;Zea;Canis;Veronica" // comma / semicolon / space separated (exact taxon name matches)
PLOTS_KRONA=1                   // Plots the bamdam results for all samples in metadata if enable. 1=enable, 0=disable
PLOTS_LIST_TAXA_EVOLUTION_FILE="taxa_list_reads_single_plot.txt" // Give a list of taxa with one taxa per line, to produce plot of abundance of each taxa as a line representation

}

// SBATCH parameters
process {
    //global, fastp, sga
    withLabel: small_memory {
        errorStrategy = 'retry'
        maxRetries = 3
        cpus = { 80 * task.attempt }
        memory = { 64.GB * task.attempt }
        time = { 6.hour * task.attempt }
    }

    // metrics and plots
    withLabel: little_memory {
        errorStrategy = 'retry'
        maxRetries = 3
        cpus = { 8 * task.attempt }
        memory = { 10.GB * task.attempt }
        time = { 30.m * task.attempt }
    }

      withName: PRINSEQ {
         cpus = 62
         memory = 50.GB
         queue = 'shared'
         time = 8.h
     }

     withName: KRAKEN2 {
         cpus = 256
         memory = 650.GB
         queue = 'memory'
         time = 34.h
     }

     withName: BOWTIE2 {
         cpus = 256
         memory = 550.GB
         queue = 'shared'
         time = 30.h
     }

    withName: MMSEQ2 {
        errorStrategy = 'retry'
        maxRetries = 3
        // setting for NT database
        cpus = 32
        memory = { 870.GB * task.attempt }
        time = { 10.hour * task.attempt }
        queue = 'memory'
    }
    
}

manifest {
    name        = "metaJAM"
    description = "in progress"
    author      = ""
    mainScript  = "main.nf"
    version     = "1"
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    	}

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    	}
    conda {
        conda.enabled = true
        }
    //test            { includeConfig 'conf/test.config'          }
    //test_full       { includeConfig 'conf/test_full.config'     }

}

// from nf-core/configs: pdc_kth for cluster dardel

params {
    project                    = "naiss2025-22-968" // Naiss project allocation
    clusterOptions             = null
    clusterName                = {
        def cluster = "unknown"
        try {
            cluster = ['/bin/bash', '-c', 'sacctmgr show cluster -n | grep -o "^\s*[^ ]*\s*"'].execute().text.trim()
        }
        catch (IOException _e) {
            System.err.println("WARNING: Could not run sacctmgr, defaulting to unknown")
        }
        cluster
    }.call()

    config_profile_description = 'PDC profile.'
    config_profile_contact     = 'Pontus Freyhult (@pontus)'
    config_profile_url         = "https://www.pdc.kth.se/"

    max_memory                 = 1790.GB
    max_cpus                   = 256
    max_time                   = 7.d

    ignore_params_list         = [
        "cluster-options",
        "clusterOptions",
        "clusterName",
        "genomes",
        "ignore_params_list",
        "input_paths",
        "max_cpus",
        "max_memory",
        "max_time",
        "project",
        "schema_ignore_params",
        "validationSchemaIgnoreParams",
    ]
}

process {
    resourceLimits = [
        memory: 1790.GB,
        cpus: 256,
        time: 7.d,
    ]
    // Should we lock these to specific versions?
    beforeScript   = 'module load PDC apptainer'

    executor       = "slurm"
    clusterOptions = {
        def clusterOptionsCreator = { mem, time, cpus ->
            def slurm_opts = [
                "-A ${params.project}",
                params.clusterOptions ?: "",
            ]

            if (params.clusterName == "dardel") {
                if (time <= 7.d && mem <= 111.GB && cpus <= 256) {
                    slurm_opts << "-p shared"
                }
                else {
                    def partition = time < 1.d
                        ? (mem > 222.GB ? 'memory,main' : 'main')
                        : (mem > 222.GB ? 'memory' : 'long')
                    slurm_opts << "-p ${partition}"
                }
                if (!mem || mem < 6.GB) {
                    // Impose minimum memory if request is below
                    slurm_opts << '--mem=6G'
                }
            }
            slurm_opts.minus("").join(" ")
        }
        clusterOptionsCreator(task.memory, task.time, task.cpus)
    }
}
